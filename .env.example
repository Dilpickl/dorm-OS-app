# ----- Supabase (recommended) -----
# Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never commit the real value. Used for catalog + checklist API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Optional: external catalog HTTP API (used only if Supabase is not configured) -----
CATALOG_API_URL=
CATALOG_API_KEY=
